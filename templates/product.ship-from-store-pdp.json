    "section_7JG6ic": {
      "type": "section",
      "blocks": {
        "text_YMLiin": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h3>How Ship From Store works</h3>",
            "width": "fit-content",
            "max_width": "narrow",
            "alignment": "left",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
