              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Mixed carts",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_xPjyGc": {
                  "type": "text",
                  "settings": {
                    "text": "<p>HotWax lets customers combine pickup and shipping items in the same order and clearly labels which items are for store pickup and which are for delivery.</p>",
