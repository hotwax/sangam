                "text_MpGFxq"
              ]
            },
            "accordion_row_jRWGkc": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Items not available for immediate pickup",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_T7giax": {
                  "type": "text",
                  "settings": {
                    "text": "<p>HotWax reduces cart abandonment by enabling orders for out-of-stock items for future pickup and displays arrival estimates, such as \"Pickup in 2 days,\" directly on the PDP. Once the inventory arrives at the selected location, HotWax triggers automated \"Ready for Pickup\" notifications to the customer.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
