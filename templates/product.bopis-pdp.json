            "accordion_row_UCwGEL": {
              "type": "_accordion-row",
              "settings": {
                "heading": "List of stores at the PDP",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_MpGFxq": {
                  "type": "text",
                  "settings": {
                    "text": "<p>HotWax identifies a customer's \"Home Store\" and displays its pickup availability directly on the PDP. When browsing more locations, \"Home Store\" remains the top priority, followed by a proximity-sorted list of nearby stores with store address, operating hours, distance from the customer’s location and one-tap Google Maps navigation.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
