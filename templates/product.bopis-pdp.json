              "blocks": {
                "text_tfCKcV": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>HotWax automates order confirmation emails to customers that include pickup information like store location, operating hours and specific collection instructions alongside a list of required documents, such as a photo ID or order number.</p>",
