{% doc %}
  @prompt
    Create a "Gift Card Exclusive" toggle filter block for Shopify collection pages. When toggled ON, it filters the visible product grid to show only products tagged "Gift Card Exclusive". When toggled OFF, all products are shown. The toggle should sit inline with the existing horizontal filter bar. It should use vanilla JavaScript to filter products client-side by checking product tags. Style it to match the existing theme's filter pill/button style — clean, minimal, no extra libraries. It should work on the BOPIS, Pre-Order, and Ship From Store collection templates which all use the horizontal filters block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-card-filter-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-gift-card-filter__toggle-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    font-family: inherit;
    user-select: none;
  }

  .ai-gift-card-filter__toggle-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-gift-card-filter__toggle-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_background_color }};
    color: {{ block.settings.active_text_color }};
    border-color: {{ block.settings.active_border_color }};
  }

  .ai-gift-card-filter__toggle-{{ ai_gen_id }}.active:hover {
    background-color: {{ block.settings.active_hover_background_color }};
    border-color: {{ block.settings.active_hover_border_color }};
  }

  .ai-gift-card-filter__checkbox-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .ai-gift-card-filter__checkmark-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    opacity: 0;
    transform: scale(0);
    transition: all 0.2s ease;
  }

  .ai-gift-card-filter__toggle-{{ ai_gen_id }}.active .ai-gift-card-filter__checkmark-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1);
  }

  .ai-gift-card-filter__label-{{ ai_gen_id }} {
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .ai-gift-card-filter__toggle-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: 8px 14px;
    }
  }
{% endstyle %}

<gift-card-filter-{{ ai_gen_id }}
  class="ai-gift-card-filter-{{ ai_gen_id }}"
  data-tag="{{ block.settings.filter_tag }}"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="ai-gift-card-filter__toggle-{{ ai_gen_id }}"
    aria-pressed="false"
    aria-label="Filter by {{ block.settings.label }}"
  >
    <span class="ai-gift-card-filter__checkbox-{{ ai_gen_id }}">
      <svg
        class="ai-gift-card-filter__checkmark-{{ ai_gen_id }}"
        viewBox="0 0 12 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M10 3L4.5 8.5L2 6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    <span class="ai-gift-card-filter__label-{{ ai_gen_id }}">{{ block.settings.label }}</span>
  </button>
</gift-card-filter-{{ ai_gen_id }}>

<script>
  (function() {
    class GiftCardFilter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.toggle = this.querySelector('.ai-gift-card-filter__toggle-{{ ai_gen_id }}');
        this.filterTag = this.dataset.tag;
        this.isActive = false;
        this.productCards = [];
      }

      connectedCallback() {
        this.setupEventListeners();
        this.findProductCards();
      }

      setupEventListeners() {
        this.toggle.addEventListener('click', () => {
          this.isActive = !this.isActive;
          this.toggle.classList.toggle('active', this.isActive);
          this.toggle.setAttribute('aria-pressed', this.isActive);
          this.filterProducts();
        });
      }

      findProductCards() {
        const productGrid = document.querySelector('.collection-product-grid, .product-grid, [id*="product-grid"]');
        if (productGrid) {
          this.productCards = Array.from(productGrid.querySelectorAll('.card-wrapper, .product-card-wrapper, [class*="product-card"]'));
        }
      }

      filterProducts() {
        if (this.productCards.length === 0) {
          this.findProductCards();
        }

        this.productCards.forEach(card => {
          const productLink = card.querySelector('a[href*="/products/"]');
          if (!productLink) return;

          const productHandle = productLink.href.split('/products/')[1]?.split('?')[0];
          if (!productHandle) return;

          const tagsElement = card.querySelector('[data-product-tags]');
          let productTags = [];

          if (tagsElement) {
            const tagsData = tagsElement.dataset.productTags;
            productTags = tagsData ? tagsData.split(',').map(tag => tag.trim().toLowerCase()) : [];
          }

          const hasTag = productTags.includes(this.filterTag.toLowerCase());

          if (this.isActive) {
            if (hasTag) {
              card.style.display = '';
              card.removeAttribute('hidden');
            } else {
              card.style.display = 'none';
              card.setAttribute('hidden', '');
            }
          } else {
            card.style.display = '';
            card.removeAttribute('hidden');
          }
        });

        this.updateProductCount();
      }

      updateProductCount() {
        const countElement = document.querySelector('.collection-product-count, [class*="product-count"]');
        if (countElement && this.isActive) {
          const visibleCount = this.productCards.filter(card => card.style.display !== 'none').length;
          const countText = countElement.textContent;
          const newCountText = countText.replace(/\d+/, visibleCount);
          countElement.textContent = newCountText;
        }
      }
    }

    customElements.define('gift-card-filter-{{ ai_gen_id }}', GiftCardFilter{{ ai_gen_id }});
  })();
</script>

