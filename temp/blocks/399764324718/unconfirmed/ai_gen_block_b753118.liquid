{% doc %}
  @prompt
    Create a new Liquid section to replace the main product grid on the BOPIS collection page (template: collection.bopis-category). The section should split collection products into two groups:
    
    1. "Exclusives" group: products where price == 100 and compare_at_price is blank. Show a prominent "Exclusives" heading above this grid.
    2. "Discounted" group: products where compare_at_price > price. No extra heading needed (or use "On Sale").
    
    Product card style to match existing: portrait image ratio, 10px border radius on image, product title (1rem, left-aligned), price (1rem, left-aligned, sale price first). Grid layout: responsive, matching existing 16px horizontal and 24px vertical column gap. Color scheme: scheme-1. Padding: 0 top, 32px bottom. Do NOT include filters or pagination - just the two product grids with the heading separator between them. Preserve all other page sections (heading, description, info banner, divider, collections carousel) - this section only replaces the product grid portion.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign exclusives = collection.products | where: 'price', 100
  assign exclusives_filtered = ''
  assign exclusives_array = ''
  
  for product in exclusives
    if product.compare_at_price == blank
      if exclusives_array == ''
        assign exclusives_array = product.id
      else
        assign exclusives_array = exclusives_array | append: ',' | append: product.id
      endif
    endif
  endfor
  
  assign exclusives_ids = exclusives_array | split: ','
  
  assign discounted = ''
  assign discounted_array = ''
  
  for product in collection.products
    if product.compare_at_price > product.price
      if discounted_array == ''
        assign discounted_array = product.id
      else
        assign discounted_array = discounted_array | append: ',' | append: product.id
      endif
    endif
  endfor
  
  assign discounted_ids = discounted_array | split: ','
%}

{% style %}
  .ai-bopis-split-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: 0;
    padding-bottom: 32px;
  }

  .ai-bopis-split-grid__section-{{ ai_gen_id }} {
    margin-bottom: 48px;
  }

  .ai-bopis-split-grid__section-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-bopis-split-grid__heading-{{ ai_gen_id }} {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 24px 0;
    color: rgb(var(--color-foreground-heading));
  }

  .ai-bopis-split-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 24px 16px;
    width: 100%;
  }

  .ai-bopis-split-grid__card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .ai-bopis-split-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 133.33%;
    overflow: hidden;
    border-radius: 10px;
    background-color: #f5f5f5;
    margin-bottom: 12px;
  }

  .ai-bopis-split-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bopis-split-grid__title-{{ ai_gen_id }} {
    font-size: 1rem;
    text-align: left;
    margin: 0 0 8px 0;
    color: rgb(var(--color-foreground));
  }

  .ai-bopis-split-grid__price-{{ ai_gen_id }} {
    font-size: 1rem;
    text-align: left;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .ai-bopis-split-grid__price-sale-{{ ai_gen_id }} {
    color: rgb(var(--color-foreground));
  }

  .ai-bopis-split-grid__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
  }

  .ai-bopis-split-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: rgb(var(--color-foreground));
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .ai-bopis-split-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 20px 12px;
    }

    .ai-bopis-split-grid__heading-{{ ai_gen_id }} {
      font-size: 1.5rem;
      margin-bottom: 16px;
    }
  }
{% endstyle %}

<bopis-split-grid-{{ ai_gen_id }} class="ai-bopis-split-grid-{{ ai_gen_id }} color-scheme-1" {{ block.shopify_attributes }}>
  {% if exclusives_ids.size > 0 %}
    <div class="ai-bopis-split-grid__section-{{ ai_gen_id }}">
      <h2 class="ai-bopis-split-grid__heading-{{ ai_gen_id }}">{{ block.settings.exclusives_heading }}</h2>
      <div class="ai-bopis-split-grid__grid-{{ ai_gen_id }}">
        {% for product in collection.products %}
          {% assign product_id_str = product.id | append: '' %}
          {% if exclusives_ids contains product_id_str %}
            {% if product.price == 100 and product.compare_at_price == blank %}
              <a href="{{ product.url }}" class="ai-bopis-split-grid__card-{{ ai_gen_id }}">
                <div class="ai-bopis-split-grid__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 500 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-bopis-split-grid__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="500"
                      height="667"
                    >
                  {% else %}
                    <div class="ai-bopis-split-grid__image-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <h3 class="ai-bopis-split-grid__title-{{ ai_gen_id }}">{{ product.title }}</h3>
                <div class="ai-bopis-split-grid__price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if discounted_ids.size > 0 %}
    <div class="ai-bopis-split-grid__section-{{ ai_gen_id }}">
      {% if block.settings.discounted_heading != blank %}
        <h2 class="ai-bopis-split-grid__heading-{{ ai_gen_id }}">{{ block.settings.discounted_heading }}</h2>
      {% endif %}
      <div class="ai-bopis-split-grid__grid-{{ ai_gen_id }}">
        {% for product in collection.products %}
          {% assign product_id_str = product.id | append: '' %}
          {% if discounted_ids contains product_id_str %}
            {% if product.compare_at_price > product.price %}
              <a href="{{ product.url }}" class="ai-bopis-split-grid__card-{{ ai_gen_id }}">
                <div class="ai-bopis-split-grid__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 500 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-bopis-split-grid__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="500"
                      height="667"
                    >
                  {% else %}
                    <div class="ai-bopis-split-grid__image-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <h3 class="ai-bopis-split-grid__title-{{ ai_gen_id }}">{{ product.title }}</h3>
                <div class="ai-bopis-split-grid__price-{{ ai_gen_id }}">
                  <span class="ai-bopis-split-grid__price-sale-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  <span class="ai-bopis-split-grid__price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                </div>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if exclusives_ids.size == 0 and discounted_ids.size == 0 %}
    <div class="ai-bopis-split-grid__empty-{{ ai_gen_id }}">
      No products match the criteria for this collection.
    </div>
  {% endif %}
</bopis-split-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class BopisSplitGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('bopis-split-grid-{{ ai_gen_id }}', BopisSplitGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "BOPIS split product grid",
  "settings": [
    {
      "type": "header",
      "content": "Exclusives section"
    },
    {
      "type": "text",
      "id": "exclusives_heading",
      "label": "Heading",
      "default": "Exclusives"
    },
    {
      "type": "paragraph",
      "content": "Shows products where price equals $100 and compare at price is blank"
    },
    {
      "type": "header",
      "content": "Discounted section"
    },
    {
      "type": "text",
      "id": "discounted_heading",
      "label": "Heading"
    },
    {
      "type": "paragraph",
      "content": "Shows products where compare at price is greater than price. Leave heading blank to hide."
    }
  ],
  "presets": [
    {
      "name": "BOPIS split product grid"
    }
  ]
}
{% endschema %}